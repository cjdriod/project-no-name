---
interface Props {
  title: string;
  id: string;
}

const { title, id } = Astro.props;
---

<section class="cv-section border-b border-border py-6" id={id} aria-labelledby={`${id}-title`}>
  <h2 class="cv-section__title mb-4 inline-block border-b-2 border-accent pb-1 text-2xl font-bold text-text" id={`${id}-title`}>{title}</h2>
  <div class="cv-section__body text-muted">
    <slot/>
  </div>
</section>

<style>
  /*
    letter-spacing/line-height use project tokens (--tracking-tight,
    --leading-tight, --leading-relaxed) whose values don't match Tailwind's
    default type scale, so they stay as scoped CSS rather than approximated
    utility classes.
  */
  .cv-section__title {
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .cv-section__body {
    line-height: var(--leading-relaxed);
  }

  @media print {
    .cv-section {
      border-bottom: none;
      padding-block: 0.35cm;
    }

    .cv-section__title {
      break-after: avoid;
      page-break-after: avoid;
    }
  }
</style>
