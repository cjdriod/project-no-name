---
import { Icon } from 'astro-icon/components';

interface Props {
  shareTitle: string;
  shareText: string;
  shareUrl: string;
}

const { shareTitle, shareText, shareUrl } = Astro.props;
---

<section
  class="flex items-center justify-start gap-2 py-6 print:hidden"
  aria-label="CV actions"
  data-cv-actions
  data-cv-share-title={`${shareTitle}`}
  data-cv-share-text={shareText}
  data-cv-share-url={shareUrl}
>
  <button
    type="button"
    class="
      inline-flex min-h-11 items-center justify-center gap-1
      rounded-lg border-none bg-transparent px-3
      text-xs font-medium text-faint
      cursor-pointer
      hover:bg-surface-muted hover:text-text
      focus-visible:bg-surface-muted focus-visible:text-text
    "
    data-cv-print
    aria-label="Print this CV"
  >
    <Icon name="material-symbols:print-outline-rounded" class="cv-actions__icon" aria-hidden="true"/>
    <span>Print</span>
  </button>
  <span class="select-none text-border" aria-hidden="true">|</span>
  <button
    type="button"
    class="
      inline-flex min-h-11 items-center justify-center gap-1
      rounded-lg border-none bg-transparent px-3
      text-xs font-medium text-faint
      cursor-pointer
      hover:bg-surface-muted hover:text-text
      focus-visible:bg-surface-muted focus-visible:text-text
    "
    data-cv-share-trigger
    aria-label="Share this CV"
    aria-haspopup="dialog"
  >
    <Icon name="material-symbols:send-rounded" class="cv-actions__icon" aria-hidden="true"/>
    <span>Share</span>
  </button>
</section>

<div class="cv-share-modal print:hidden" data-cv-share-modal hidden>
  <div class="cv-share-modal__backdrop" data-cv-share-backdrop></div>
  <div
    class="cv-share-modal__dialog rounded-xl border border-border bg-surface p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cv-share-title"
    data-cv-share-dialog
  >
    <h2 id="cv-share-title" class="mb-4 text-lg font-semibold text-text">Share this CV</h2>
    <label class="mb-1 block text-sm text-muted" for="cv-share-phone">Phone</label>
    <div class="flex items-stretch">
      <span
        class="inline-flex items-center rounded-l-lg border border-e-0 border-border bg-surface-muted px-3 font-mono font-medium text-muted"
        aria-hidden="true"
      >+60</span>
      <input
        id="cv-share-phone"
        class="min-h-11 min-w-0 flex-1 rounded-r-lg border border-border bg-bg px-3 py-2 text-base text-text"
        type="tel"
        inputmode="numeric"
        autocomplete="off"
        maxlength="10"
        placeholder="191234567"
        aria-label="Local phone number (without country code)"
        data-cv-share-phone
      />
    </div>
    <button
      type="button"
      class="mt-6 flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-lg border border-accent bg-accent font-semibold text-surface hover:bg-accent-hover focus-visible:bg-accent-hover"
      data-cv-share-submit
    >
      <Icon name="material-symbols:send-rounded" class="cv-share-modal__submit-icon" aria-hidden="true"/>
      <span>Share</span>
    </button>
  </div>
</div>

<div
  class="cv-toast rounded-full bg-text px-6 py-2 text-sm font-semibold text-surface print:hidden"
  data-cv-toast
  hidden
>Copied</div>

<script>
  import { initCvShare } from '../../scripts/cv-share';

  const printBtn = document.querySelector<HTMLButtonElement>('[data-cv-print]');
  printBtn?.addEventListener('click', () => window.print());

  const actionsEl = document.querySelector<HTMLElement>('[data-cv-actions]');

  initCvShare({
    triggerEl: document.querySelector('[data-cv-share-trigger]'),
    modalEl: document.querySelector('[data-cv-share-modal]'),
    dialogEl: document.querySelector('[data-cv-share-dialog]'),
    backdropEl: document.querySelector('[data-cv-share-backdrop]'),
    phoneInputEl: document.querySelector('[data-cv-share-phone]'),
    submitBtnEl: document.querySelector('[data-cv-share-submit]'),
    toastEl: document.querySelector('[data-cv-toast]'),
    shareTitle: actionsEl?.dataset.cvShareTitle ?? document.title,
    shareText: actionsEl?.dataset.cvShareText ?? '',
    shareUrl: actionsEl?.dataset.cvShareUrl ?? location.href,
  });
</script>

<style>
  /* 0.95rem / 1.1rem icon sizes and --shadow-lg are custom tokens with no
     equivalent Tailwind scale value, so they remain as scoped CSS instead of
     arbitrary-value utility classes. */
  .cv-actions__icon {
    width: 0.95rem;
    height: 0.95rem;
  }

  .cv-share-modal__submit-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .cv-share-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
  }

  .cv-share-modal[hidden] {
    display: none;
  }

  .cv-share-modal__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, black 45%, transparent);
  }

  .cv-share-modal__dialog {
    position: relative;
    z-index: 1;
    width: min(90vw, 360px);
    margin: 15vh auto 0;
    box-shadow: var(--shadow-lg);
  }

  .cv-toast {
    position: fixed;
    bottom: var(--space-4);
    left: 50%;
    z-index: var(--z-tooltip);
    transform: translate(-50%, 0);
    box-shadow: var(--shadow-lg);
  }

  .cv-toast[hidden] {
    display: none;
  }
</style>

