---
import type { CollectionEntry } from 'astro:content';
import CvSection from './CvSection.astro';

interface Props {
  items: CollectionEntry<'activities'>[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
<CvSection title="Recent activities" id="activities">
  <ul class="flex flex-col gap-2 m-0 p-0 list-none" role="list">
    {items.map((item) => {
      const { title, year } = item.data;
      return (
        <li class="flex flex-col items-start gap-1 break-inside-avoid sm:flex-row sm:flex-wrap sm:items-baseline sm:justify-between sm:gap-2">
          <span>{title}</span>
          <span class="font-mono text-sm whitespace-nowrap text-faint">{year}</span>
        </li>
      );
    })}
  </ul>
</CvSection>
  )}
