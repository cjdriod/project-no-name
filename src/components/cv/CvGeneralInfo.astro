---
import {Icon} from 'astro-icon/components';

interface Contact {
  channel: 'email' | 'linkedin' | 'github';
  label: string;
  description: string;
  href: string;
  icon: string;
}

interface Props {
  legalName: string;
  role: string;
  contacts: Contact[];
  qrSvg: string | null;
  cvUrl: string;
}

const {legalName, role, contacts, qrSvg, cvUrl} = Astro.props;

const email = contacts.find((c) => c.channel === 'email');
const linkedin = contacts.find((c) => c.channel === 'linkedin');
const github = contacts.find((c) => c.channel === 'github');

const stripProtocol = (href: string) => href.replace(/^https?:\/\//, '');
---

<div class="cv-general grid gap-6 py-6" id="general-info">
  <div class="cv-general__left">
    <p class="cv-general__legal-name">{legalName}</p>
    <p class="mt-1 mb-4 text-lg font-medium text-muted">{role}</p>
    <ul class="m-0 flex list-none flex-col gap-2 p-0" role="list">
      <li class="flex flex-wrap gap-2 md:gap-4">
        {email && (
          <a class="inline-flex items-center gap-2 text-base text-text"
             href={email.href}
             rel="noopener noreferrer"
             aria-label=`${email.label} (opens in a new tab)`
          >
            <Icon name="material-symbols:mail" class="cv-general__icon flex-none text-accent" aria-hidden="true"/>
            <span>{email.description}</span>
          </a>
        )}
        <span class="inline-flex items-center gap-2 text-base text-text" data-cv-phone data-default="Upon Request">
          <Icon name="material-symbols:call" class="cv-general__icon flex-none text-accent" aria-hidden="true"/>
          <span data-cv-phone-value>Upon Request</span>
        </span>
      </li>
      <li class="flex flex-wrap gap-2 md:gap-4">
        {linkedin && (
          <a class="inline-flex items-center gap-2 text-base text-text"
             href={linkedin.href}
             rel="noopener noreferrer"
             aria-label=`${linkedin.label} (opens in a new tab)`
          >
            <Icon name="simple-icons:linkedin" class="cv-general__icon flex-none text-accent" aria-hidden="true"/>
            <span>{stripProtocol(linkedin.href)}</span>
          </a>
        )}
        {github && (
          <a class="inline-flex items-center gap-2 text-base text-text"
             href={github.href}
             rel="noopener noreferrer"
             aria-label=`${github.label} (opens in a new tab)`
          >
            <Icon name="simple-icons:github" class="cv-general__icon flex-none text-accent" aria-hidden="true"/>
            <span>{stripProtocol(github.href)}</span>
          </a>
        )}
      </li>
    </ul>
  </div>
  <div class="cv-general__right">
    {qrSvg && (
      <div class="cv-general__qr h-32 w-32" role="img" aria-label={`QR code linking to ${cvUrl}`} set:html={qrSvg}/>
    )}
  </div>
</div>

<script>
  import {fromTelParam, toTelParam, format} from '../../scripts/cv-phone';

  const STORAGE_KEY = 'cv:tel';
  const params = new URLSearchParams(location.search);

  const fromUrl = fromTelParam(params.get('tel'));
  if (fromUrl) {
    sessionStorage.setItem(STORAGE_KEY, fromUrl)
  }

  const phoneNumber = fromUrl ?? sessionStorage.getItem(STORAGE_KEY);
  if (phoneNumber) {
    const el = document.querySelector('[data-cv-phone-value]');
    if (el) el.textContent = format(phoneNumber);
  }
</script>

<style>
  /*
    Kept as scoped CSS:
    - .cv-general__legal-name: font-size/letter-spacing/line-height use
      project tokens (fluid clamp() / values) that don't match Tailwind's
      default type scale, so the whole rule stays together for readability.
    - grid-template-columns tracks (1fr auto) and the .cv-general__right
      responsive/print visibility are tied to the same breakpoints and use
      a non-standard "auto" track, so they remain grouped here.
    - .cv-general__icon: 1.1rem icon size has no matching Tailwind token.
    - .cv-general__qr svg sizing/dark-mode filter target markup injected via
      set:html, so classes can't be applied directly to it.
  */
  .cv-general {
    grid-template-columns: 1fr;
  }

  .cv-general__legal-name {
    margin: 0;
    color: var(--text);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    white-space: nowrap;
  }

  .cv-general__icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .cv-general__right {
    display: none;
  }

  .cv-general__qr :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media screen {
    :global(html[data-theme='dark']) .cv-general__qr {
      filter: invert(1);
    }
  }

  @media (min-width: 768px) {
    .cv-general {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .cv-general__right {
      display: block;
    }
  }

  @media print {
    .cv-general {
      grid-template-columns: 1fr auto;
    }

    .cv-general__right {
      display: block;
    }
  }
</style>
