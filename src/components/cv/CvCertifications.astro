---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import CvSection from './CvSection.astro';

interface Props {
  items: CollectionEntry<'achievements'>[];
}

const { items } = Astro.props;
---

<CvSection title="Certification" id="certification">
  <ul class="m-0 flex list-none flex-col gap-4 p-0" role="list">
    {items.map((item) => {
      const { title, issuer, date, link } = item.data;
      const meta = [issuer, date].filter(Boolean);
      return (
        <li class="cv-cert-entry">
          <p class="m-0 font-semibold text-text">
            {link ? (
              <a class="text-inherit no-underline hover:text-accent! focus-visible:text-accent!" href={link} target="_blank" rel="noopener noreferrer"
                 aria-label={`${title} (opens in a new tab)`}>
                {title}
                <Icon name="material-symbols:open-in-new-rounded" aria-hidden="true"
                      class="cv-cert-entry__icon inline-block! align-middle ms-1 text-faint"/>
              </a>
            ) : (
              title
            )}
          </p>
          {meta.length > 0 && <p class="mt-1 font-mono text-sm text-faint">{meta.join(' · ')}</p>}
        </li>
      );
    })}
  </ul>
</CvSection>

<style>
  /* break-inside/page-break-inside print fallback pairing has no single
     Tailwind utility equivalent, so it stays as scoped CSS. Icon size
     (0.85rem) is a custom token with no matching Tailwind scale value. */
  .cv-cert-entry {
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .cv-cert-entry__icon {
    width: 0.85rem;
    height: 0.85rem;
  }
</style>
