---
interface Props {
  dismissLabel?: string;
}
---

<div
  class="cv-alert flex items-center justify-between gap-4 border-b border-border bg-surface-muted py-3 text-sm text-muted print:hidden"
  id="cv-alert"
  data-cv-alert
>
  <p class="m-0">
    Looking for a simpler view? <a class="font-semibold text-accent! underline underline-offset-2" href="/about">click here</a>.
  </p>
  <button
    type="button"
    class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center border-none bg-transparent text-xl leading-none text-muted hover:text-text focus-visible:text-text"
    data-cv-alert-dismiss
    aria-label="Dismiss this message"
  >
    &times;
  </button>
</div>

<script>
  const alertEl = document.querySelector('[data-cv-alert]');
  const dismissBtn = document.querySelector('[data-cv-alert-dismiss]');
  dismissBtn?.addEventListener('click', () => {
    alertEl?.remove();
  });
</script>

<style>
  /* --gutter is a responsive clamp() token with no Tailwind equivalent. */
  .cv-alert {
    padding-inline: var(--gutter);
  }
</style>
