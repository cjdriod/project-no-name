---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  items: CollectionEntry<'education'>[];
}

const { items } = Astro.props;
---

<section class="section" id="education" aria-labelledby="edu-title">
  <div class="section__intro" data-reveal>
    <p class="section__eyebrow">Background</p>
    <h2 id="edu-title">Education</h2>
  </div>
  <ul class="edu-list" role="list">
    {items.map((item, index) => {
      const { school, course, photo, photoAlt, start, end } = item.data;
      return (
        <li class="edu-entry" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
          <Image
            src={photo}
            alt={photoAlt ?? `${school} logo`}
            width={64}
            height={64}
            loading="lazy"
            decoding="async"
            class="edu-entry__logo"
          />
          <div class="edu-entry__body">
            <div class="edu-entry__header">
              <h3 class="edu-entry__school">{school}</h3>
              <span class="edu-entry__period">{start} — {end}</span>
            </div>
            <p class="edu-entry__course">{course}</p>
          </div>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .section {
    padding-block: var(--space-12);
  }

  .section__intro {
    margin-bottom: var(--space-6);
  }

  .section__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: var(--text);
    font-size: var(--text-3xl);
    letter-spacing: -0.015em;
    line-height: var(--leading-tight);
  }

  .edu-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--border-thin) solid var(--border);
  }

  .edu-entry {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-6);
    border-bottom: var(--border-thin) solid var(--border);
  }

  .edu-entry__logo {
    width: 3.5rem;
    height: 3.5rem;
    border: var(--border-thin) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    object-fit: cover;
    flex-shrink: 0;
  }

  .edu-entry__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .edu-entry__school {
    margin: 0;
    color: var(--text);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .edu-entry__period {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .edu-entry__course {
    margin: 0;
    color: var(--text-muted);
    font-weight: var(--weight-medium);
  }

  p {
    margin: 0;
  }
</style>
