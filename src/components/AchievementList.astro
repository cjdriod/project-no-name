---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'achievements'>[];
}

const { items } = Astro.props;
---

<section class="section" id="achievements" aria-labelledby="ach-title">
  <div class="section__intro" data-reveal>
    <p class="section__eyebrow">Recognition</p>
    <h2 id="ach-title">Achievements</h2>
  </div>
  <ul class="ach-list" role="list">
    {items.map((item, index) => {
      const { title, issuer, date, link } = item.data;
      const meta = [issuer, date].filter(Boolean);
      const rowContent = (
        <>
          <span class="ach-left">
            <span class="ach-title">
              {title}
              {link && (
                <Icon
                  name="material-symbols:open-in-new-rounded"
                  aria-hidden="true"
                  class="ach-ext-icon"
                />
              )}
            </span>
          </span>
          {meta.length > 0 && (
            <span class="ach-meta" aria-label={meta.join(' · ')}>
              {issuer && <span>{issuer}</span>}
              {issuer && date && <span class="ach-meta__dot" aria-hidden="true">·</span>}
              {date && <span>{date}</span>}
            </span>
          )}
        </>
      );
      return (
        <li class="ach-entry" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
          {link ? (
            <a
              href={link}
              target="_blank"
              rel="noopener noreferrer"
              class="ach-row ach-row--link"
              aria-label={`${title}${issuer ? ` — ${issuer}` : ''} (opens in a new tab)`}
            >
              {rowContent}
            </a>
          ) : (
            <div class="ach-row">
              {rowContent}
            </div>
          )}
        </li>
      );
    })}
  </ul>
</section>

<style>
  .section { padding-block: var(--space-12); }
  .section__intro { margin-bottom: var(--space-6); }
  .section__eyebrow { margin: 0 0 var(--space-2); color: var(--accent); font-size: var(--text-sm); font-weight: var(--weight-semibold); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  h2 { margin: 0; color: var(--text); font-size: var(--text-3xl); letter-spacing: -0.015em; line-height: var(--leading-tight); }

  .ach-list { margin: 0; padding: 0; list-style: none; border-top: var(--border-thin) solid var(--border); }
  .ach-entry { border-bottom: var(--border-thin) solid var(--border); }

  /* Row: title left, meta right; wraps meta to a new line on narrow screens */
  .ach-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-6);
    min-height: 44px;
    color: inherit;
  }
  .ach-row--link {
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) var(--ease-out);
  }
  .ach-row--link:hover { color: var(--accent); }
  .ach-row--link:hover .ach-ext-icon { color: var(--accent); }
  .ach-row--link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Left: title + optional icon inline */
  .ach-left {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    min-width: 0;
  }
  .ach-title {
    color: var(--text);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }
  .ach-ext-icon {
    display: inline-block;
    width: 0.875rem;
    height: 0.875rem;
    margin-inline-start: var(--space-1);
    vertical-align: middle;
    color: var(--text-faint);
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* Right: provider · year */
  .ach-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .ach-meta__dot { color: var(--text-faint); }
</style>
