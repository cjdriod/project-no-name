---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import ProjectCard from './ProjectCard.astro';

interface Contact {
  channel: 'email' | 'linkedin' | 'github';
  label: string;
  href: string;
  icon: string;
}

interface Props {
  projects: CollectionEntry<'projects'>[];
  contacts: Contact[];
}

const { projects, contacts } = Astro.props;
const items = projects.toReversed();
const githubHref = contacts.find((contact) => contact.channel === 'github')?.href;
---

<section class="section projects-section" id="projects" aria-labelledby="projects-title">
  <div class="section__intro" data-reveal>
    <p class="section__eyebrow">Selected work</p>
    <h2 id="projects-title">Projects</h2>
  </div>
  <ul class="projects-grid" role="list">
    {items.map((item, index) => (
      <li data-reveal style={`--reveal-delay: ${index * 70}ms`}>
        <ProjectCard {...item.data} />
      </li>
    ))}
    {githubHref && (
      <li data-reveal style={`--reveal-delay: ${items.length * 70}ms`}>
        <a
          class="view-more-card"
          href={githubHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View more projects on GitHub (opens in a new tab)"
        >
          <Icon class="view-more-card__icon" name="logos:github-icon" aria-hidden="true" />
          <span class="view-more-card__title">More on GitHub</span>
          <p class="view-more-card__description">Explore the rest of my repositories and open-source work.</p>
          <span class="button button--secondary view-more-card__cta">View profile</span>
        </a>
      </li>
    )}
  </ul>
</section>

<style>
  .section { padding-block: var(--space-12); }
  .section__intro { margin-bottom: var(--space-6); }
  .section__eyebrow { margin: 0 0 var(--space-2); color: var(--accent); font-size: var(--text-sm); font-weight: var(--weight-semibold); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  h2 { margin: 0; color: var(--text); font-size: var(--text-3xl); letter-spacing: -0.015em; line-height: var(--leading-tight); }
  .projects-grid { display: grid; gap: var(--space-6); margin: 0; padding: 0; list-style: none; grid-template-columns: 1fr; align-items: stretch; }
  .projects-grid > li { list-style: none; }
  @media (min-width: 1024px) { .projects-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .view-more-card { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-2); width: 100%; height: 100%; min-height: 12rem; border: var(--border-thin) dashed var(--border); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-sm); padding: var(--space-8) var(--space-6); text-align: center; text-decoration: none; transition: box-shadow var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out); }
  .view-more-card:hover, .view-more-card:focus-visible { border-color: var(--accent); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  @media (prefers-reduced-motion: reduce) { .view-more-card:hover, .view-more-card:focus-visible { transform: none; } }
  .view-more-card__icon { width: 2rem; height: 2rem; color: var(--text); }
  .view-more-card__title { color: var(--text); font-size: var(--text-lg); font-weight: var(--weight-semibold); }
  .view-more-card__description { max-width: 26ch; margin: 0; color: var(--text-muted); font-size: var(--text-sm); line-height: var(--leading-relaxed); }
  .view-more-card__cta { margin-top: var(--space-2); pointer-events: none; }
  .button { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; gap: var(--space-2); border-radius: var(--radius-md); font-weight: var(--weight-semibold); padding: var(--space-3) var(--space-6); text-decoration: none; transition: background-color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out); }
  .button--secondary { border: var(--border-thin) solid var(--border); background: transparent; color: var(--text); }
  .view-more-card:hover .button--secondary, .view-more-card:focus-visible .button--secondary { border-color: var(--accent); color: var(--accent); }
</style>
