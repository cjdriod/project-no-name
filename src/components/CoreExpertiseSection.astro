---
import type { CollectionEntry } from 'astro:content';
import SkillPill from './SkillPill.astro';

interface Props {
  categories: CollectionEntry<'skills'>[];
}

const { categories } = Astro.props;
const homeCategories = categories.filter((category) => category.data.pages.includes('home'));
---

<section class="section" id="core-expertise" aria-labelledby="core-expertise-title">
  <div class="section__intro" data-reveal>
    <p class="section__eyebrow">Core expertise</p>
    <h2 id="core-expertise-title">Focused delivery across the full platform</h2>
  </div>
  <div class="expertise-list">
    {homeCategories.map((category, index) => (
      <article class="expertise-row" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
        <div class="expertise-row__heading">
          <span class="expertise-row__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{category.data.name}</h3>
        </div>
        <ul class="skills-list" aria-label={`${category.data.name} skills`}>
          {category.data.skills.slice(0, 3).map((skill) => (
            <li>
              <SkillPill name={skill.name} icon={skill.icon}/>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-12);
  }

  .section__intro {
    max-width: var(--container-prose);
    margin-bottom: var(--space-8);
  }

  .section__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: var(--text);
    font-size: var(--text-3xl);
    letter-spacing: -0.015em;
    line-height: var(--leading-tight);
  }

  .expertise-list {
    border-block: var(--border-thin) solid var(--border);
  }

  .expertise-row {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }

  .expertise-row + .expertise-row {
    border-top: var(--border-thin) solid var(--border);
  }

  .expertise-row__heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
  }

  .expertise-row__index {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
  }

  h3 {
    margin: 0;
    color: var(--text);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1024px) {
    .expertise-row {
      grid-template-columns: minmax(12rem, 0.36fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-8);
    }
  }
</style>
