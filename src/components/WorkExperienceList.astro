---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  items: CollectionEntry<'experience'>[];
}

const { items } = Astro.props;
---

<section class="section" id="experience" aria-labelledby="exp-title">
  <div class="section__intro" data-reveal>
    <p class="section__eyebrow">Career</p>
    <h2 id="exp-title">Work Experience</h2>
  </div>
  <ul class="exp-list" role="list">
    {items.map((item, index) => {
      const { company, position, photo, photoAlt, start, end, summary } = item.data;
      return (
        <li class="exp-entry" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
          <Image
            src={photo}
            alt={photoAlt ?? `${company} logo`}
            width={64}
            height={64}
            loading="lazy"
            decoding="async"
            class="exp-entry__logo"
          />
          <div class="exp-entry__body">
            <div class="exp-entry__header">
              <h3 class="exp-entry__company">{company}</h3>
              <span class="exp-entry__period">{start} — {end}</span>
            </div>
            <p class="exp-entry__position">{position}</p>
            <p class="exp-entry__summary">{summary}</p>
          </div>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .section {
    padding-block: var(--space-12);
  }

  .section__intro {
    margin-bottom: var(--space-6);
  }

  .section__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: var(--text);
    font-size: var(--text-3xl);
    letter-spacing: -0.015em;
    line-height: var(--leading-tight);
  }

  .exp-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--border-thin) solid var(--border);
  }

  .exp-entry {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-6);
    border-bottom: var(--border-thin) solid var(--border);
  }

  .exp-entry__logo {
    width: 3.5rem;
    height: 3.5rem;
    border: var(--border-thin) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    object-fit: cover;
    flex-shrink: 0;
  }

  .exp-entry__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .exp-entry__company {
    margin: 0;
    color: var(--text);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .exp-entry__period {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .exp-entry__position {
    margin: 0 0 var(--space-3);
    color: var(--accent);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
  }

  .exp-entry__summary {
    margin: 0;
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  p {
    margin: 0;
  }
</style>
