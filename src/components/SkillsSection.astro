---
import type { CollectionEntry } from 'astro:content';
import SkillPill from './SkillPill.astro';

interface Props {
  skills: CollectionEntry<'skills'>[];
}

const { skills } = Astro.props;
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="section__intro" data-reveal>
    <p class="section__eyebrow">Selected skills</p>
    <h2 id="skills-title">Cloud, systems, and full-stack delivery</h2>
  </div>
  <ul class="skills-list" data-reveal>
    {skills.map((skill) => (
      <li><SkillPill name={skill.data.name} icon={skill.data.icon} /></li>
    ))}
  </ul>
</section>

<style>
  .section { padding-block: var(--space-12) var(--space-24); }
  .section__intro { max-width: var(--container-prose); margin-bottom: var(--space-6); }
  .section__eyebrow { margin: 0 0 var(--space-2); color: var(--accent); font-size: var(--text-sm); font-weight: var(--weight-semibold); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  h2 { margin: 0; color: var(--text); font-size: var(--text-3xl); letter-spacing: -0.015em; line-height: var(--leading-tight); }
  .skills-list { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: 0; padding: 0; list-style: none; }
</style>
