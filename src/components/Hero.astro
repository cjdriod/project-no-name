---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
  profile: CollectionEntry<'profile'>;
}

const { profile } = Astro.props;
const data = profile.data;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__content">
    <p class="hero__tagline" data-reveal style="--reveal-delay: 0ms">{data.tagline}</p>
    <p class="hero__greeting" data-reveal style="--reveal-delay: 60ms">{data.greeting}</p>
    <h1 id="hero-title" data-reveal style="--reveal-delay: 120ms">{data.name}</h1>
    <p class="hero__role" data-reveal style="--reveal-delay: 180ms">{data.role}</p>
    <p class="hero__description" data-reveal style="--reveal-delay: 240ms">{data.description}</p>
    <div class="hero__actions" data-reveal style="--reveal-delay: 300ms">
      <a class="button button--primary" href={data.projectsHref}>
        <span>View Projects</span>
        <Icon name="material-symbols:grid-view-outline-rounded" aria-hidden="true" />
      </a>
      <a class="button button--secondary" href={data.cvHref}>
        <span>View CV</span>
        <Icon name="material-symbols:description-outline-rounded" aria-hidden="true" />
      </a>
    </div>
  </div>
  <figure class="hero__portrait" data-reveal style="--reveal-delay: 360ms">
    <img src={data.photo} alt={data.photoAlt} width="640" height="640" loading="eager" decoding="async" />
  </figure>
</section>

<style>
  .hero { display: grid; gap: var(--space-12); align-items: center; min-height: min(760px, calc(100svh - 9rem)); padding-block: var(--space-16) var(--space-12); }
  .hero__content { max-width: var(--container-prose); }
  .hero__tagline { width: fit-content; margin: 0 0 var(--space-6); border-radius: var(--radius-full); background: var(--surface-muted); color: var(--accent); font-size: var(--text-sm); font-weight: var(--weight-semibold); letter-spacing: var(--tracking-wide); padding: var(--space-2) var(--space-4); text-transform: uppercase; }
  .hero__greeting, .hero__role { margin: 0; color: var(--text-muted); font-size: var(--text-lg); font-weight: var(--weight-medium); }
  h1 { max-width: 12ch; margin: var(--space-3) 0; color: var(--text); font-size: var(--text-5xl); font-weight: var(--weight-bold); letter-spacing: var(--tracking-tight); line-height: 1.05; }
  .hero__role { color: var(--accent); font-size: var(--text-xl); font-weight: var(--weight-semibold); }
  .hero__description { max-width: 62ch; margin: var(--space-6) 0 0; color: var(--text-muted); font-size: var(--text-lg); line-height: var(--leading-relaxed); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }
  .button { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; gap: var(--space-2); border-radius: var(--radius-md); font-weight: var(--weight-semibold); padding: var(--space-3) var(--space-6); text-decoration: none; transition: background-color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out); }
  .button svg { width: 1.2rem; height: 1.2rem; }
  .button--primary { border: var(--border-thin) solid var(--accent); background: var(--accent); color: var(--surface); }
  .button--primary:hover { border-color: var(--accent-hover); background: var(--accent-hover); }
  .button--secondary { border: var(--border-thin) solid var(--border); background: transparent; color: var(--text); }
  .button--secondary:hover { border-color: var(--accent); color: var(--accent); }
  .button:active { transform: translateY(1px); }
  .hero__portrait { max-width: min(100%, 22rem); margin: 0; justify-self: center; }
  .hero__portrait img { width: 100%; height: auto; border: var(--border-thin) solid var(--border); border-radius: clamp(2rem, 8vw, 6rem); background: var(--surface-muted); box-shadow: var(--shadow-lg); }
  @media (min-width: 1024px) { .hero { grid-template-columns: minmax(0, 1fr) minmax(18rem, 25rem); padding-block: var(--space-24) var(--space-16); } .hero__portrait { justify-self: end; } }
  @media (max-width: 420px) { .hero { min-height: auto; padding-block: var(--space-12) var(--space-8); } .hero__actions { flex-direction: column; } .button { width: 100%; } }
</style>
