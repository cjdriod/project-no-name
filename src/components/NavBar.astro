---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';

const items = [
  { label: 'Home', href: '/', icon: 'material-symbols:home-outline-rounded', priority: 'home' },
  { label: 'About', href: '/about', icon: 'material-symbols:person-outline-rounded', priority: 'about' },
  { label: 'Projects', href: '/projects', icon: 'material-symbols:folder-outline-rounded', priority: 'projects' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav class="bottom-nav" aria-label="Primary">
  <ul class="bottom-nav__list">
    {items.map((item) => {
      const isCurrent = pathname === item.href;
      return (
        <li class={`bottom-nav__item bottom-nav__item--${item.priority}`}>
          <a class="bottom-nav__link" href={item.href} aria-label={item.label} aria-current={isCurrent ? 'page' : undefined} data-tooltip={item.label}>
            <Icon name={item.icon} aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        </li>
      );
    })}
  </ul>
  <span class="bottom-nav__separator" aria-hidden="true"></span>
  <ThemeToggle />
</nav>

<style>
  .bottom-nav { position: fixed; bottom: max(var(--space-4), env(safe-area-inset-bottom)); left: 50%; z-index: var(--z-header); display: flex; max-width: calc(100vw - var(--space-4)); align-items: center; gap: var(--space-2); transform: translateX(-50%); border: var(--border-thin) solid var(--border); border-radius: var(--radius-full); background: var(--surface); box-shadow: var(--shadow-lg); padding: var(--space-2); }
  .bottom-nav__list { display: flex; align-items: center; gap: var(--space-1); margin: 0; padding: 0; list-style: none; }
  .bottom-nav__item { display: block; }
  .bottom-nav__link { position: relative; display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; gap: var(--space-2); border-radius: var(--radius-full); color: var(--text-muted); font-size: var(--text-sm); font-weight: var(--weight-semibold); padding: 0 var(--space-3); text-decoration: none; transition: background-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out); }
  .bottom-nav__link svg { width: 1.25rem; height: 1.25rem; flex: 0 0 auto; }
  .bottom-nav__link:hover, .bottom-nav__link:focus-visible { background: var(--surface-muted); color: var(--text); }
  .bottom-nav__link[aria-current="page"] { background: color-mix(in srgb, var(--accent) 16%, var(--surface-muted)); box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 42%, transparent); color: var(--accent); }
  .bottom-nav__link::after { position: absolute; bottom: calc(100% + var(--space-3)); left: 50%; pointer-events: none; transform: translateX(-50%) translateY(2px); border: var(--border-thin) solid var(--border); border-radius: var(--radius-md); background: var(--surface); box-shadow: var(--shadow-sm); color: var(--text); content: attr(data-tooltip); font-size: var(--text-xs); opacity: 0; padding: var(--space-1) var(--space-2); transition: opacity 120ms var(--ease-out), transform 120ms var(--ease-out); white-space: nowrap; }
  .bottom-nav__link:hover::after, .bottom-nav__link:focus-visible::after { opacity: 1; transform: translateX(-50%) translateY(0); }
  .bottom-nav__separator { width: 1px; height: 28px; background: var(--border); }
  @media (min-width: 1024px) { .bottom-nav { gap: var(--space-3); padding: var(--space-2) var(--space-3); } .bottom-nav__list { gap: var(--space-2); } .bottom-nav__link { padding: 0 var(--space-4); } }
  .bottom-nav__item--projects { display: none; }
  @media (min-width: 768px) { .bottom-nav__item--projects { display: block; } }
  @media (max-width: 360px) { .bottom-nav { max-width: calc(100vw - var(--space-2)); gap: var(--space-1); padding: var(--space-1); } }
</style>
