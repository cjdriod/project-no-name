---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';

const items = [
  { label: 'Home', href: '/', icon: 'material-symbols:home-outline-rounded', priority: 'home' },
  { label: 'About', href: '/about', icon: 'material-symbols:person-outline-rounded', priority: 'about' },
  { label: 'CV', href: '/cv', icon: 'material-symbols:description-outline-rounded', priority: 'cv' },
  { label: 'Projects', href: '/projects', icon: 'material-symbols:folder-outline-rounded', priority: 'projects' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav
  class="bottom-nav fixed left-1/2 flex -translate-x-1/2 items-center gap-2 rounded-full border border-border bg-surface p-2 lg:gap-3 lg:px-3"
  aria-label="Primary">
  <ul class="m-0 flex list-none items-center gap-1 p-0 lg:gap-2">
    {items.map((item, index) => {
      const isCurrent = pathname === item.href;
      const visibilityClass = item.priority === 'projects' ? 'sr-only md:not-sr-only md:block' : 'block';
      return (
        <li class={visibilityClass}>
          <a
            class="bottom-nav__link relative inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-full px-3 text-sm font-semibold text-muted no-underline transition duration-150 ease-out hover:bg-surface-muted hover:text-text focus-visible:bg-surface-muted focus-visible:text-text lg:px-4"
            href={item.href} aria-label={item.label}
            aria-current={isCurrent ? 'page' : undefined} data-tooltip={item.label}
          >
            <Icon class="h-5 w-5 flex-none" name={item.icon} aria-hidden="true"/>
            <span>{item.label}</span>
          </a>
        </li>
      );
    })}
  </ul>
  <span class="h-7 w-px bg-border" aria-hidden="true"></span>
  <ThemeToggle/>
</nav>

<style>
  .bottom-nav {
    bottom: max(var(--space-4), env(safe-area-inset-bottom));
    z-index: var(--z-header);
    max-width: calc(100vw - var(--space-4));
    box-shadow: var(--shadow-lg);
  }

  .bottom-nav__link[aria-current="page"] {
    background: color-mix(in srgb, var(--accent) 16%, var(--surface-muted));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 42%, transparent);
    color: var(--accent);
  }

  .bottom-nav__link::after {
    position: absolute;
    bottom: calc(100% + var(--space-3));
    left: 50%;
    pointer-events: none;
    transform: translateX(-50%) translateY(2px);
    border: var(--border-thin) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    color: var(--text);
    content: attr(data-tooltip);
    font-size: var(--text-xs);
    opacity: 0;
    padding: var(--space-1) var(--space-2);
    transition: opacity 120ms var(--ease-out), transform 120ms var(--ease-out);
    white-space: nowrap;
  }

  .bottom-nav__link:hover::after, .bottom-nav__link:focus-visible::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (max-width: 360px) {
    .bottom-nav {
      max-width: calc(100vw - var(--space-2));
      gap: var(--space-1);
      padding: var(--space-1);
    }
  }
</style>
