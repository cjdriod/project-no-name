---
import type { CollectionEntry } from 'astro:content';
import SkillPill from './SkillPill.astro';

interface Props {
  categories: CollectionEntry<'skills'>[];
}

const { categories } = Astro.props;
const aboutCategories = categories.filter((c) => c.data.pages.includes('about'));
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="section__intro" data-reveal>
    <p class="section__eyebrow">Skills</p>
    <h2 id="skills-title">What I work with</h2>
  </div>
  <div class="skills-grid">
    {aboutCategories.map((category, i) => (
      <div class="skill-category" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
        <h3 class="skill-category__name">{category.data.name}</h3>
        <ul class="skill-category__pills" aria-label={`${category.data.name} skills`}>
          {category.data.skills.map((skill) => (
            <li><SkillPill name={skill.name} icon={skill.icon} /></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .section { padding-block: var(--space-12); }
  .section__intro { margin-bottom: var(--space-8); }
  .section__eyebrow { margin: 0 0 var(--space-2); color: var(--accent); font-size: var(--text-sm); font-weight: var(--weight-semibold); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  h2 { margin: 0; color: var(--text); font-size: var(--text-3xl); letter-spacing: -0.015em; line-height: var(--leading-tight); }
  .skills-grid { display: grid; gap: var(--space-8); }
  .skill-category__name { margin: 0 0 var(--space-4); color: var(--text); font-size: var(--text-lg); font-weight: var(--weight-semibold); }
  .skill-category__pills { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 1024px) {
    .skills-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
