---
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  icon?: string;
}

const { name, icon } = Astro.props;
---

<span class="inline-flex min-h-9 items-center gap-2 rounded-full bg-surface-muted px-4 py-2 text-sm font-medium text-muted">
  {icon &&
    <Icon name={icon} class="h-4 w-4 text-text" aria-hidden="true"/>}
  <span>{name}</span>
</span>
