---
import type { CollectionEntry } from 'astro:content';
import ExperienceCard from './ExperienceCard.astro';

interface Props {
  items: CollectionEntry<'experience'>[];
}

const { items } = Astro.props;
---

<section class="py-12" id="experience" aria-labelledby="experience-title">
  <div class="section__intro mb-6" data-reveal>
    <p class="section__eyebrow mb-2 text-sm font-semibold uppercase text-accent">Recent work</p>
    <h2 id="experience-title" class="section__title m-0 text-3xl leading-tight text-text">Experience</h2>
  </div>
  <ul class="m-0 grid list-none gap-4 p-0">
    {items.slice(0, 3).map((item, index) => (
      <li data-reveal style={`--reveal-delay: ${index * 70}ms`}>
        <ExperienceCard {...item.data}/>
      </li>
    ))}
  </ul>
</section>

<style>
  .section__eyebrow {
    letter-spacing: var(--tracking-wide);
  }

  .section__title {
    letter-spacing: -0.015em;
  }
</style>
