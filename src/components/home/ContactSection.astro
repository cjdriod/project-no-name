---
import { Icon } from 'astro-icon/components';

interface Contact {
  channel: 'email' | 'linkedin' | 'github';
  label: string;
  description: string;
  href: string;
  icon: string;
}

interface Props {
  contacts: Contact[];
}

const { contacts } = Astro.props;
const availableContacts = contacts.filter((contact) => contact.href.trim().length > 0);
---

<section class="contact-section py-12" id="contact" aria-labelledby="contact-title">
  <div class="section__intro mb-6" data-reveal>
    <p class="section__eyebrow mb-2 text-sm font-semibold uppercase text-accent">Get in touch</p>
    <h2 id="contact-title" class="m-0 text-3xl leading-tight text-text">Let's connect</h2>
    <p class="mt-3 text-lg leading-relaxed text-muted">Choose the channel that works best for you.</p>
  </div>
  <ul class="contact-list m-0 flex max-[420px]:grid flex-wrap gap-3 p-0" data-reveal>
    {availableContacts.map((contact) => (
      <li class="flex-1 basis-64">
        <a
          class="contact-link group flex min-h-12 min-w-64 max-[420px]:w-full items-start gap-3 rounded-lg border border-border bg-surface px-4 py-3 font-semibold text-text no-underline transition duration-150 ease-out hover:border-accent hover:text-accent focus-visible:border-accent focus-visible:text-accent active:translate-y-px"
          href={contact.href} target="_blank" rel="noopener noreferrer"
           aria-label={`${contact.label} (opens in a new tab)`}>
          <span class="contact-link__channel-icon" data-channel={contact.channel} aria-hidden="true">
            <Icon name={contact.icon} aria-hidden="true"/>
          </span>
          <span class="flex min-w-0 flex-1 flex-col gap-1">
            <span class="flex items-center justify-between gap-2">
              <span class="truncate">{contact.label}</span>
              <Icon
                class="contact-link__external-icon flex-none text-faint transition group-hover:-translate-y-px group-hover:translate-x-px group-hover:text-current group-focus-visible:-translate-y-px group-focus-visible:translate-x-px group-focus-visible:text-current"
                name="material-symbols:open-in-new-rounded" aria-hidden="true"/>
            </span>
            <span class="truncate text-sm font-normal leading-snug text-muted">{contact.description}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .section__intro {
    max-width: var(--container-prose);
  }

  .section__eyebrow {
    letter-spacing: var(--tracking-wide);
  }

  .contact-link__channel-icon {
    display: inline-flex;
    width: 1.2rem;
    height: 1.2rem;
    flex: 0 0 1.2rem;
    align-items: center;
    justify-content: center;
    margin-top: 0.15rem;
    line-height: 0;
  }

  .contact-link__channel-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The GitHub logo is a fixed near-black fill, invert it in dark mode so it stays visible on the dark surface. */
  :global(html[data-theme='dark']) .contact-link__channel-icon[data-channel='github'] :global(svg) {
    filter: invert(1);
  }

  /* The LinkedIn logo's "in" lettering is a cutout that reveals the background; force it white in both themes. */
  .contact-link__channel-icon[data-channel='linkedin'] {
    background: #fff;
    border-radius: 20%;
  }

  .contact-link__external-icon {
    width: 0.95rem;
    height: 0.95rem;
  }
</style>
