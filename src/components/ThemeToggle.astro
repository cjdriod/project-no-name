---
import { Icon } from 'astro-icon/components';
---

<button class="theme-toggle" type="button" aria-label="Toggle light and dark theme">
  <Icon class="theme-toggle__icon theme-toggle__icon--light" name="material-symbols:light-mode-outline-rounded"
        aria-hidden="true"/>
  <Icon class="theme-toggle__icon theme-toggle__icon--dark" name="material-symbols:dark-mode-outline-rounded"
        aria-hidden="true"/>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const syncThemeToggle = () => {
    if (!button) return;
    const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    button.dataset.theme = theme;
    button.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
  };
  syncThemeToggle();
  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = nextTheme;
    localStorage.setItem('theme', nextTheme);
    syncThemeToggle();
  });
</script>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
    width: 44px;
    min-width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--surface-muted);
    color: var(--text);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .theme-toggle:hover {
    background: color-mix(in srgb, var(--accent) 16%, var(--surface-muted));
    color: var(--accent);
  }

  .theme-toggle__icon {
    position: absolute;
    width: 1.2rem;
    height: 1.2rem;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .theme-toggle__icon--dark, .theme-toggle[data-theme="dark"] .theme-toggle__icon--light {
    opacity: 0;
  }

  .theme-toggle[data-theme="dark"] .theme-toggle__icon--dark {
    opacity: 1;
  }
</style>
