---
import { Icon } from 'astro-icon/components';
---

<button
  class="theme-toggle relative inline-flex h-11 w-11 min-w-11 items-center justify-center rounded-full border-0 bg-surface-muted text-text cursor-pointer transition-colors duration-150 ease-out"
  type="button" aria-label="Toggle light and dark theme">
  <Icon class="theme-toggle__icon theme-toggle__icon--light absolute transition-opacity duration-150 ease-out"
        name="material-symbols:light-mode-outline-rounded" aria-hidden="true"/>
  <Icon class="theme-toggle__icon theme-toggle__icon--dark absolute transition-opacity duration-150 ease-out"
        name="material-symbols:dark-mode-outline-rounded" aria-hidden="true"/>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const syncThemeToggle = () => {
    if (!button) return;
    const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    button.dataset.theme = theme;
    button.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
  };
  syncThemeToggle();
  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = nextTheme;
    localStorage.setItem('theme', nextTheme);
    syncThemeToggle();
  });
</script>

<style>
  .theme-toggle:hover {
    background: color-mix(in srgb, var(--accent) 16%, var(--surface-muted));
    color: var(--accent);
  }

  .theme-toggle__icon {
    width: 1.2rem;
    height: 1.2rem;
  }

  .theme-toggle__icon--dark, .theme-toggle[data-theme="dark"] .theme-toggle__icon--light {
    opacity: 0;
  }

  .theme-toggle[data-theme="dark"] .theme-toggle__icon--dark {
    opacity: 1;
  }
</style>
