---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  technologies: string[];
  sourceHref: string;
  siteHref?: string;
}

const { title, description, image, imageAlt, technologies, sourceHref, siteHref } = Astro.props;
---

<article class="project-card">
  <div class="project-card__header">
    <div class="project-card__image-wrap">
      <Image src={image} alt={imageAlt} loading="lazy" decoding="async" width={400} height={400} />
    </div>
    <div class="project-card__heading">
      <h3 class="project-card__title">{title}</h3>
      <p class="project-card__description">{description}</p>
    </div>
  </div>
  <div class="project-card__body">
    <ul class="project-card__tech" role="list">
      {technologies.map((tech) => (
        <li class="project-card__tech-pill">{tech}</li>
      ))}
    </ul>
    <div class="project-card__actions">
      <a
        class="project-card__link"
        href={sourceHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${title} source code (opens in a new tab)`}
      >
        <Icon name="material-symbols:code-rounded" aria-hidden="true" />
        <span>Source</span>
      </a>
      {siteHref && (
        <>
          <span class="project-card__divider" aria-hidden="true">|</span>
          <a
            class="project-card__link"
            href={siteHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${title} live website (opens in a new tab)`}
          >
            <Icon name="material-symbols:public" aria-hidden="true" />
            <span>Website</span>
          </a>
        </>
      )}
    </div>
  </div>
</article>

<style>
  .project-card { display: flex; flex-direction: column; width: 100%; height: 100%; border: var(--border-thin) solid var(--border); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-sm); overflow: hidden; transition: box-shadow var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out); }
  .project-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  @media (prefers-reduced-motion: reduce) { .project-card:hover { transform: none; } }
  .project-card__header { display: flex; align-items: flex-start; gap: var(--space-4); padding: var(--space-4) var(--space-4) 0; }
  .project-card__image-wrap { flex: 0 0 4rem; width: 4rem; aspect-ratio: 1 / 1; border-radius: var(--radius-md); overflow: hidden; background: var(--surface-muted); }
  .project-card__image-wrap img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .project-card__heading { min-width: 0; }
  .project-card__body { display: flex; flex: 1; min-width: 0; flex-direction: column; padding: var(--space-4); }
  .project-card__title { margin: 0; color: var(--text); font-size: var(--text-lg); font-weight: var(--weight-semibold); line-height: var(--leading-snug); }
  .project-card__description { margin: var(--space-2) 0 0; color: var(--text-muted); font-size: var(--text-sm); line-height: var(--leading-relaxed); }
  .project-card__tech { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0 0 var(--space-4); padding: 0; list-style: none; }
  .project-card__tech-pill { border-radius: var(--radius-full); background: var(--surface-muted); color: var(--text-muted); font-size: var(--text-sm); padding: var(--space-1) var(--space-3); }
  .project-card__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin-top: auto; padding-top: var(--space-2); border-top: var(--border-thin) solid var(--border); }
  .project-card__divider { color: var(--border); font-size: var(--text-sm); }
  .project-card__link { display: inline-flex; min-height: 32px; align-items: center; gap: var(--space-2); color: var(--text); font-size: var(--text-sm); font-weight: var(--weight-semibold); letter-spacing: var(--tracking-wide); text-decoration: none; transition: color var(--duration-fast) var(--ease-out); }
  .project-card__link:hover, .project-card__link:focus-visible { color: var(--accent); }
  .project-card__link svg { width: 1.1rem; height: 1.1rem; flex: 0 0 auto; }

  @media (min-width: 1024px) {
    .project-card__header { flex-direction: column; gap: 0; padding: 0; }
    .project-card__image-wrap { width: 100%; flex-basis: auto; border-radius: 0; }
    .project-card__heading { padding: var(--space-6) var(--space-6) 0; }
    .project-card__body { padding: var(--space-6); }
    .project-card__title { font-size: var(--text-xl); }
    .project-card__description { font-size: var(--text-base); }
    .project-card__tech { margin: 0 0 var(--space-6); }
  }
</style>
