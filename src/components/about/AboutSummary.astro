---
import { Icon } from 'astro-icon/components';

interface Props {
  description: string;
  highlights: string[];
}

const { description, highlights } = Astro.props;
---

<section class="py-12" id="summary" aria-labelledby="summary-title">
  <div class="section__intro mb-6" data-reveal>
    <p class="section__eyebrow mb-2 text-sm font-semibold uppercase text-accent">About me</p>
    <h2 id="summary-title" class="section__title m-0 text-3xl leading-tight text-text">Professional Summary</h2>
  </div>
  <div class="summary-body" data-reveal style="--reveal-delay: 80ms">
    <p class="mb-6 text-lg leading-relaxed text-muted text-justify">{description}</p>
    <ul class="m-0 flex list-none flex-col gap-3 p-0" aria-label="Highlights">
      {highlights.map((item) => (
        <li class="flex items-start gap-2 leading-relaxed text-muted">
          <Icon name="material-symbols:check-rounded" class="highlights-icon shrink-0 text-accent"
                aria-hidden="true"/>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section__eyebrow {
    letter-spacing: var(--tracking-wide);
  }

  .section__title {
    letter-spacing: -0.015em;
  }

  .summary-body {
    max-width: var(--container-content);
  }

  .highlights-icon {
    width: 1.1em;
    height: 1.1em;
    margin-top: 0.2em;
  }
</style>
