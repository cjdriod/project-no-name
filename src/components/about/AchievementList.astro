---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'achievements'>[];
}

const { items } = Astro.props;
---

<section class="py-12" id="achievements" aria-labelledby="ach-title">
  <div class="section__intro mb-6" data-reveal>
    <p class="section__eyebrow mb-2 text-sm font-semibold uppercase text-accent">Recognition</p>
    <h2 id="ach-title" class="section__title m-0 text-3xl leading-tight text-text">Achievements</h2>
  </div>
  <ul class="m-0 list-none border-t border-border p-0" role="list">
    {items.map((item, index) => {
      const { title, issuer, date, link } = item.data;
      const meta = [issuer, date].filter(Boolean);
      const rowContent = (
        <>
          <span class="ach-left inline-flex min-w-0 items-baseline gap-2">
            <span class="ach-title text-xl font-semibold leading-snug text-text">
              {title}
              {link && (
                <Icon
                  name="material-symbols:open-in-new-rounded"
                  aria-hidden="true"
                  class="ach-ext-icon ms-1 inline-block! h-3.5 w-3.5 align-middle text-faint transition-colors duration-150 ease-out group-hover:text-accent"
                />)}
            </span>
          </span>
          {meta.length > 0 && (<span class="flex items-baseline gap-2 whitespace-nowrap font-mono text-sm text-faint"
                                     aria-label={meta.join(' · ')}>
              {issuer && <span>{issuer}</span>}
              {issuer && date && <span class="text-faint" aria-hidden="true">·</span>}
              {date && <span>{date}</span>}
            </span>)}
        </>);
      return (
        <li class="ach-entry border-b border-border" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
          {link ? (<a
              href={link}
              target="_blank"
              rel="noopener noreferrer"
              class="ach-row group flex min-h-11 flex-wrap items-baseline justify-between gap-x-6 gap-y-2 rounded-sm py-6 text-inherit no-underline transition-colors duration-150 ease-out hover:text-accent focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-accent"
              aria-label={`${title}${issuer ? ` — ${issuer}` : ''} (opens in a new tab)`}
            >
              {rowContent}
            </a>) : (
            <div
              class="ach-row flex min-h-11 flex-wrap items-baseline justify-between gap-x-6 gap-y-2 py-6 text-inherit">
              {rowContent}
            </div>)}
        </li>);
    })}
  </ul>
</section>

<style>
  .section__eyebrow {
    letter-spacing: var(--tracking-wide);
  }

  .section__title {
    letter-spacing: -0.015em;
  }
</style>
