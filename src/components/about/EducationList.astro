---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  items: CollectionEntry<'education'>[];
}

const { items } = Astro.props;
---

<section class="py-12" id="education" aria-labelledby="edu-title">
  <div class="section__intro mb-6" data-reveal>
    <p class="section__eyebrow mb-2 text-sm font-semibold uppercase text-accent">Background</p>
    <h2 id="edu-title" class="section__title m-0 text-3xl leading-tight text-text">Education</h2>
  </div>
  <ul class="m-0 list-none border-t border-border p-0" role="list">
    {items.map((item, index) => {
      const { school, course, photo, photoAlt, start, end } = item.data;
      return (
        <li class="edu-entry grid items-start gap-4 border-b border-border py-6" data-reveal
            style={`--reveal-delay: ${index * 70}ms`}>
          <Image
            src={photo}
            alt={photoAlt ?? `${school} logo`}
            width={64}
            height={64}
            loading="lazy"
            decoding="async"
            class="h-14 w-14 shrink-0 rounded-md border border-border bg-surface-muted object-cover"
          />
          <div>
            <div class="mb-1 flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="m-0 text-xl font-semibold leading-snug text-text">{school}</h3>
              <span class="whitespace-nowrap font-mono text-sm text-faint">{start} — {end}</span>
            </div>
            <p class="m-0 font-medium text-muted">{course}</p>
          </div>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .section__eyebrow {
    letter-spacing: var(--tracking-wide);
  }

  .section__title {
    letter-spacing: -0.015em;
  }

  .edu-entry {
    grid-template-columns: 4rem minmax(0, 1fr);
  }
</style>
