---
import {
  getCollection,
  getEntry
} from 'astro:content';
import NavBar from '../components/NavBar.astro';
import ProjectsSection from '../components/project/ProjectsSection.astro';
import Layout from '../layouts/Layout.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Missing profile content entry.');

const projects = await getCollection('projects');
---

<Layout
  title={`${profile.data.name} | Projects`}
  description={`Selected projects built by ${profile.data.name}, ${profile.data.role}.`}
>
  <a class="skip-link" href="#projects">Skip to content</a>
  <main id="projects" class="page-shell">
    <h1 class="page-title" data-reveal>Projects</h1>
    <ProjectsSection projects={projects} contacts={profile.data.contacts}/>
  </main>
  <NavBar/>
</Layout>
