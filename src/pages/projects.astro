---
import {
  getCollection,
  getEntry
} from 'astro:content';
import NavBar from '../components/NavBar.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import Layout from '../layouts/Layout.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Missing profile content entry.');

const projects = await getCollection('projects');
---

<Layout
  title={`${profile.data.name} | Projects`}
  description={`Selected projects built by ${profile.data.name}, ${profile.data.role}.`}
>
  <a class="skip-link" href="#projects-title">Skip to content</a>
  <main id="projects" class="projects-shell">
    <h1 class="page-title" data-reveal>Projects</h1>
    <ProjectsSection projects={projects} contacts={profile.data.contacts}/>
  </main>
  <NavBar/>
</Layout>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    z-index: var(--z-header);
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--surface);
    font-weight: var(--weight-semibold);
    padding: var(--space-2) var(--space-4);
    text-decoration: none;
  }

  .skip-link:focus {
    top: var(--space-4);
  }

  .projects-shell {
    width: min(100%, var(--container-wide));
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-bottom: calc(var(--space-32) + env(safe-area-inset-bottom));
  }

  .page-title {
    margin: 0;
    padding-top: var(--space-12);
    color: var(--text);
    font-size: var(--text-5xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
  }

  @media (min-width: 1024px) {
    .page-title {
      font-size: clamp(3rem, 6vw, 4.5rem);
    }
  }
</style>
