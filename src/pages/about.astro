---
import {
  getCollection,
  getEntry
} from 'astro:content';
import AboutSkills from '../components/about/AboutSkills.astro';
import AboutSummary from '../components/about/AboutSummary.astro';
import AchievementList from '../components/about/AchievementList.astro';
import CvCallout from '../components/about/CvCallout.astro';
import EducationList from '../components/about/EducationList.astro';
import NavBar from '../components/NavBar.astro';
import WorkExperienceList from '../components/about/WorkExperienceList.astro';
import Layout from '../layouts/Layout.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Missing profile content entry.');

const skillCategories = await getCollection('skills');
const experience = (await getCollection('experience')).toReversed();
const achievements = (await getCollection('achievements')).toReversed();
const education = (await getCollection('education')).toReversed();
---

<Layout
  title={`${profile.data.name} | About`}
  description={`Professional background and skills for ${profile.data.name}, ${profile.data.role}.`}
>
  <a class="skip-link" href="#about">Skip to content</a>
  <main id="about" class="page-shell">
    <h1 class="page-title" data-reveal>{profile.data.name}</h1>
    <AboutSummary description={profile.data.description} highlights={profile.data.highlights}/>
    <AboutSkills categories={skillCategories}/>
    <WorkExperienceList items={experience}/>
    {achievements.length > 0 &&
      <AchievementList items={achievements}/>}
    <EducationList items={education}/>
    <CvCallout />
  </main>
  <NavBar/>
</Layout>
