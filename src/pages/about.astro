---
import {
  getCollection,
  getEntry
} from 'astro:content';
import AboutSkills from '../components/AboutSkills.astro';
import AboutSummary from '../components/AboutSummary.astro';
import AchievementList from '../components/AchievementList.astro';
import CvCallout from '../components/CvCallout.astro';
import EducationList from '../components/EducationList.astro';
import NavBar from '../components/NavBar.astro';
import WorkExperienceList from '../components/WorkExperienceList.astro';
import Layout from '../layouts/Layout.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Missing profile content entry.');

const skillCategories = await getCollection('skills');
const experience = (await getCollection('experience')).toReversed();
const achievements = (await getCollection('achievements')).toReversed();
const education = (await getCollection('education')).toReversed();
---

<Layout
  title={`${profile.data.name} | About`}
  description={`Professional background and skills for ${profile.data.name}, ${profile.data.role}.`}
>
  <a class="skip-link" href="#summary">Skip to content</a>
  <main id="about" class="about-shell">
    <h1 class="page-title" data-reveal>{profile.data.name}</h1>
    <AboutSummary description={profile.data.description} highlights={profile.data.highlights}/>
    <AboutSkills categories={skillCategories}/>
    <WorkExperienceList items={experience}/>
    {achievements.length > 0 &&
      <AchievementList items={achievements}/>}
    {education.length > 0 &&
      <EducationList items={education}/>}
    <CvCallout cvHref={profile.data.cvHref}/>
  </main>
  <NavBar/>
</Layout>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    z-index: var(--z-header);
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--surface);
    font-weight: var(--weight-semibold);
    padding: var(--space-2) var(--space-4);
    text-decoration: none;
  }

  .skip-link:focus {
    top: var(--space-4);
  }

  .about-shell {
    width: min(100%, var(--container-wide));
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-bottom: calc(var(--space-32) + env(safe-area-inset-bottom));
  }

  .page-title {
    margin: 0;
    padding-top: var(--space-12);
    color: var(--text);
    font-size: var(--text-5xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
  }

  @media (min-width: 1024px) {
    .page-title {
      font-size: clamp(3rem, 6vw, 4.5rem);
    }
  }
</style>
