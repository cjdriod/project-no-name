---
import {
  getCollection,
  getEntry
} from 'astro:content';
import ContactSection from '../components/home/ContactSection.astro';
import CoreExpertiseSection from '../components/home/CoreExpertiseSection.astro';
import ExperienceSection from '../components/home/ExperienceSection.astro';
import Hero from '../components/home/Hero.astro';
import NavBar from '../components/NavBar.astro';
import Layout from '../layouts/Layout.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) {
  throw new Error('Missing profile content entry.');
}

const experience = (await getCollection('experience')).toReversed().slice(0, 3);

const skillCategories = await getCollection('skills');
---

<Layout>
  <a class="skip-link" href="#home">Skip to content</a>
  <main id="home" class="page-shell" aria-labelledby="hero-title">
    <Hero profile={profile}/>
    <CoreExpertiseSection categories={skillCategories}/>
    <ExperienceSection items={experience}/>
    <ContactSection contacts={profile.data.contacts}/>
  </main>
  <NavBar/>
</Layout>
