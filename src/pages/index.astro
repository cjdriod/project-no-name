---
import { getCollection, getEntry } from 'astro:content';
import ExperienceSection from '../components/ExperienceSection.astro';
import Hero from '../components/Hero.astro';
import NavBar from '../components/NavBar.astro';
import SkillsSection from '../components/SkillsSection.astro';
import Layout from '../layouts/Layout.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) {
  throw new Error('Missing profile content entry.');
}

const experience = (await getCollection('experience'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const skills = (await getCollection('skills')).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
---

<Layout>
  <a class="skip-link" href="#home">Skip to content</a>
  <main id="home" class="home-shell" aria-labelledby="hero-title">
    <Hero profile={profile} />
    <ExperienceSection items={experience} />
    <SkillsSection skills={skills} />
  </main>
  <NavBar />
</Layout>

<style>
  .home-shell { width: min(100%, var(--container-wide)); margin-inline: auto; padding-inline: var(--gutter); padding-bottom: calc(var(--space-32) + env(safe-area-inset-bottom)); }
</style>
