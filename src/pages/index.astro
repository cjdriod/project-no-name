---
import { getCollection, getEntry } from 'astro:content';
import ContactSection from '../components/ContactSection.astro';
import CoreExpertiseSection from '../components/CoreExpertiseSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import Hero from '../components/Hero.astro';
import NavBar from '../components/NavBar.astro';
import Layout from '../layouts/Layout.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) {
  throw new Error('Missing profile content entry.');
}

const experience = (await getCollection('experience')).toReversed().slice(0, 3);

const skillCategories = await getCollection('skills');
---

<Layout>
  <a class="skip-link" href="#home">Skip to content</a>
  <main id="home" class="home-shell" aria-labelledby="hero-title">
    <Hero profile={profile} />
    <CoreExpertiseSection categories={skillCategories} />
    <ExperienceSection items={experience} />
    <ContactSection contacts={profile.data.contacts} />
  </main>
  <NavBar />
</Layout>

<style>
  .home-shell { width: min(100%, var(--container-wide)); margin-inline: auto; padding-inline: var(--gutter); padding-bottom: calc(var(--space-32) + env(safe-area-inset-bottom)); }
</style>
