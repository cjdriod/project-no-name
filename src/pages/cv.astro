---
import {
  getCollection,
  getEntry
} from 'astro:content';
import QRCode from 'qrcode';
import CvActivities from '../components/cv/CvActivities.astro';
import CvActions from '../components/cv/CvActions.astro';
import CvAlert from '../components/cv/CvAlert.astro';
import CvCertifications from '../components/cv/CvCertifications.astro';
import CvEducation from '../components/cv/CvEducation.astro';
import CvExperience from '../components/cv/CvExperience.astro';
import CvGeneralInfo from '../components/cv/CvGeneralInfo.astro';
import CvLanguages from '../components/cv/CvLanguages.astro';
import CvSection from '../components/cv/CvSection.astro';
import CvSkills from '../components/cv/CvSkills.astro';
import NavBar from '../components/NavBar.astro';
import Layout from '../layouts/Layout.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Missing profile content entry.');

const skillCategories = await getCollection('skills');
const experience = (await getCollection('experience')).toReversed();
const certifications = (await getCollection('achievements')).toReversed();
const education = (await getCollection('education')).toReversed();
const activities = (await getCollection('activities')).toReversed();

const cvUrl = new URL(`${import.meta.env.BASE_URL}cv`.replace(/\/{2,}/g, '/'), Astro.site).toString();

let qrSvg: string | null = null;
try {
  qrSvg = await QRCode.toString(cvUrl, {
    type: 'svg', color: {
      light: '#0000'
    }
  });
} catch {
  qrSvg = null;
}
---

<Layout
  title={`${profile.data.legalName} | CV`}
  description={`Comprehensive curriculum vitae for ${profile.data.name}, ${profile.data.role}.`}
>
  <a class="skip-link" href="#cv">Skip to content</a>
  <CvAlert/>
  <main id="cv" class="page-shell page-shell--narrow">
    <h1 class="visually-hidden">{profile.data.legalName} — Curriculum Vitae</h1>
    <CvGeneralInfo
      legalName={profile.data.legalName}
      role={profile.data.role}
      contacts={profile.data.contacts}
      qrSvg={qrSvg}
      cvUrl={cvUrl}
    />
    <CvSection title="Profile" id="profile">
      <div class="flex flex-col gap-4">
        {profile.data.professionalSummary.map(content => <p class="text-justify">{content}</p>)}
      </div>
    </CvSection>
    <CvExperience items={experience}/>
    <CvCertifications items={certifications}/>
    <CvSkills categories={skillCategories}/>
    <CvEducation items={education}/>
    <CvActivities items={activities}/>
    <CvLanguages languages={profile.data.languages}/>
    <CvActions
      shareTitle={`${profile.data.name} — CV`}
      shareText={`Take a look at ${profile.data.name}'s CV.`}
      shareUrl={cvUrl}
    />
  </main>
  <NavBar/>
</Layout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .cv-summary {
    margin: 0;
    max-width: var(--container-prose);
    color: var(--text-muted);
  }

  @media print {
    #cv {
      width: 100%;
      padding: 0;
    }

    .skip-link {
      display: none;
    }
  }
</style>
